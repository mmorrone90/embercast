<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_pressed="true">
        <shape><solid android:color="#415A4B" /><corners android:radius="8dp" />
            <stroke android:width="3dp" android:color="@color/accent" /></shape>
    </item>
    <item android:state_focused="true">
        <shape><solid android:color="#354B40" /><corners android:radius="8dp" />
            <stroke android:width="3dp" android:color="@color/accent" /></shape>
    </item>
    <item>
        <shape><solid android:color="@color/surface" /><corners android:radius="8dp" />
            <stroke android:width="1dp" android:color="#51636B" /></shape>
    </item>
</selector>
