<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="match_parent" android:fillViewport="true">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical"
        android:paddingStart="48dp" android:paddingEnd="48dp" android:paddingTop="28dp" android:paddingBottom="28dp">
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
            android:text="@string/diagnostics" android:textSize="32sp" android:textColor="@color/text_primary" />
        <TextView style="@style/BodyText" android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginTop="12dp" android:text="@string/diagnostics_intro" />
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginTop="18dp" android:orientation="horizontal">
            <Button android:id="@+id/backButton" style="@style/TvButton" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/back"><requestFocus /></Button>
            <Button android:id="@+id/refreshButton" style="@style/TvButton" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginStart="16dp" android:text="@string/refresh" />
        </LinearLayout>
        <TextView android:id="@+id/report" style="@style/BodyText"
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginTop="20dp" android:fontFamily="monospace" android:textSize="16sp" android:lineSpacingExtra="6dp" />
    </LinearLayout>
</ScrollView>
