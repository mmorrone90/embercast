<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="match_parent"
    android:fillViewport="true">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
        android:orientation="vertical" android:paddingStart="48dp" android:paddingEnd="48dp"
        android:paddingTop="28dp" android:paddingBottom="28dp">
        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:text="@string/brand" android:textSize="14sp" android:letterSpacing="0.18"
            android:textColor="@color/accent" />
        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:layout_marginTop="14dp" android:text="@string/ready"
            android:textSize="40sp" android:fontFamily="sans-serif-medium" android:textColor="@color/text_primary" />
        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:layout_marginTop="6dp" android:text="@string/phase_notice"
            android:textSize="16sp" android:textColor="@color/pending" />
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginTop="24dp" android:orientation="horizontal" android:baselineAligned="false">
            <LinearLayout android:layout_width="0dp" android:layout_weight="1.2"
                android:layout_height="wrap_content" android:orientation="vertical" android:paddingStart="0dp" android:paddingEnd="32dp">
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:text="@string/receiver" android:textSize="12sp" android:letterSpacing="0.1"
                    android:textColor="@color/text_secondary" />
                <TextView android:id="@+id/receiverName" android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:layout_marginTop="6dp" android:textSize="26sp" android:textColor="@color/text_primary"
                    android:maxLines="2" android:ellipsize="end" />
                <TextView android:id="@+id/instructions" style="@style/BodyText"
                    android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:layout_marginTop="18dp" android:lineSpacingExtra="5dp" />
                <TextView style="@style/BodyText" android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:layout_marginTop="16dp" android:text="@string/integration_pending" android:textSize="16sp" />
            </LinearLayout>
            <LinearLayout android:layout_width="0dp" android:layout_weight="1"
                android:layout_height="wrap_content" android:orientation="vertical">
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:text="@string/local_ip" android:textSize="12sp" android:textColor="@color/text_secondary" />
                <TextView android:id="@+id/localIp" android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:layout_marginTop="4dp" android:textSize="22sp" android:textColor="@color/text_primary" />
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:layout_marginTop="14dp" android:text="@string/status" android:textSize="12sp" android:textColor="@color/text_secondary" />
                <TextView android:id="@+id/connectionStatus" style="@style/BodyText"
                    android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="4dp" />
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:layout_marginTop="14dp" android:text="@string/device" android:textSize="12sp" android:textColor="@color/text_secondary" />
                <TextView android:id="@+id/connectedDevice" style="@style/BodyText"
                    android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="4dp" />
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:layout_marginTop="14dp" android:orientation="horizontal" android:baselineAligned="false">
                    <LinearLayout android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:orientation="vertical">
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/resolution" android:textSize="12sp" android:textColor="@color/text_secondary" />
                        <TextView android:id="@+id/resolution" style="@style/BodyText" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="4dp" />
                    </LinearLayout>
                    <LinearLayout android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:orientation="vertical">
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/fps" android:textSize="12sp" android:textColor="@color/text_secondary" />
                        <TextView android:id="@+id/fps" style="@style/BodyText" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="4dp" />
                    </LinearLayout>
                </LinearLayout>
            </LinearLayout>
        </LinearLayout>
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginTop="24dp" android:orientation="horizontal">
            <Button android:id="@+id/settingsButton" style="@style/TvButton"
                android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/settings">
                <requestFocus />
            </Button>
            <Button android:id="@+id/diagnosticsButton" style="@style/TvButton"
                android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:layout_marginStart="16dp" android:text="@string/diagnostics" />
        </LinearLayout>
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginTop="12dp" android:text="@string/remote_hint" android:textSize="14sp" android:textColor="@color/text_secondary" />
    </LinearLayout>
</ScrollView>
