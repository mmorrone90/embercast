+                            Text(stringResource(R.string.captures_preview))
+                        }
+                        TextButton(onClick = {
+                            if (address == null) {
+                                transferError = noNetworkMessage
+                            } else {
+                                runCatching { CaptureTransferServer(file, address!!) }
+                                    .onSuccess { transferFile = file; transfer = it }
+                                    .onFailure { transferError = it.message ?: captureFailedMessage }
+                            }
+                        }, modifier = Modifier.dpadFocus()) {
+                            Text(stringResource(R.string.captures_download))
+                        }
+                        TextButton(onClick = {
+                            val uri = FileProvider.getUriForFile(context, "${context.packageName}.fileprovider", file)
+                            val mime = if (file.extension == "mp4") "video/mp4" else "image/png"
+                            val intent = Intent(Intent.ACTION_SEND).apply {
+                                type = mime
+                                putExtra(Intent.EXTRA_STREAM, uri)
+                                addFlags(Intent.FLAG_GRANT_READ_URI_PERMISSION)
+                            }
+                            context.startActivity(Intent.createChooser(intent, shareTitle))
+                        }, modifier = Modifier.dpadFocus()) {
+                            Text(stringResource(R.string.captures_share))
+                        }
+                        TextButton(onClick = { toDelete = file }, modifier = Modifier.dpadFocus()) {
+                            Icon(Icons.Default.Delete, null)
+                            Text(stringResource(R.string.captures_delete))
+                        }
+                    }
+                    HorizontalDivider()
+                }
+            }
+        }
+    }
+
+    toPreview?.let { file ->
+        CapturePreview(file = file, onClose = { toPreview = null })
+    }
+
+    transfer?.let { server ->
+        AlertDialog(
+            onDismissRequest = { transfer = null },
+            title = { Text(stringResource(R.string.captures_download_title)) },
+            text = {
+                Column(verticalArrangement = Arrangement.spacedBy(12.dp)) {
+                    Text(transferFile?.name ?: "FireMirror capture")
+                    Text(stringResource(R.string.captures_download_hint))
+                    Text(server.url, color = MaterialTheme.colorScheme.primary,
+                        style = MaterialTheme.typography.titleMedium)
+                }
+            },
+            confirmButton = {
+                TextButton(onClick = { transfer = null }, modifier = Modifier.dpadFocus()) {
+                    Text(stringResource(R.string.captures_cancel))
+                }
+            }
+        )
+    }
+
+    transferError?.let { error ->
+        AlertDialog(
+            onDismissRequest = { transferError = null },
+            title = { Text(stringResource(R.string.capture_failed)) },
+            text = { Text(error) },
+            confirmButton = {
+                TextButton(onClick = { transferError = null }, modifier = Modifier.dpadFocus()) {
+                    Text(stringResource(R.string.btn_ok))
+                }
+            }
+        )
+    }
+
+    toDelete?.let { file ->
+        AlertDialog(
+            onDismissRequest = { toDelete = null },
+            title = { Text(stringResource(R.string.captures_delete_title)) },
+            text = { Text(stringResource(R.string.captures_delete_message, file.name)) },
+            confirmButton = {
+                TextButton(onClick = {
+                    file.delete()
+                    captures = files()
+                    toDelete = null
+                }, modifier = Modifier.dpadFocus()) { Text(stringResource(R.string.captures_delete)) }
+            },
+            dismissButton = {
+                TextButton(onClick = { toDelete = null }, modifier = Modifier.dpadFocus()) {
+                    Text(stringResource(R.string.captures_cancel))
+                }
+            }
+        )
+    }
+}
+
+@Composable
+private fun CapturePreview(file: File, onClose: () -> Unit) {
+    var video by remember(file) { mutableStateOf<VideoView?>(null) }
+    DisposableEffect(file) { onDispose { video?.stopPlayback() } }
+    AlertDialog(
+        onDismissRequest = onClose,
+        title = { Text(file.name) },
+        text = {
+            if (file.extension == "png") {
+                val bitmap = remember(file) { BitmapFactory.decodeFile(file.absolutePath)?.asImageBitmap() }
+                if (bitmap != null) {
+                    Image(bitmap, null, modifier = Modifier.fillMaxWidth().height(360.dp))
+                } else {
+                    Text(stringResource(R.string.capture_failed))
+                }
+            } else {
+                Column {
+                    AndroidView(
+                        factory = { ctx ->
+                            VideoView(ctx).apply {
+                                setVideoPath(file.absolutePath)
+                                setOnPreparedListener { start() }
+                                video = this
+                            }
+                        },
+                        modifier = Modifier.fillMaxWidth().height(360.dp)
+                    )
+                    TextButton(onClick = {
+                        video?.let { if (it.isPlaying) it.pause() else it.start() }
+                    }, modifier = Modifier.dpadFocus()) {
+                        Text(stringResource(R.string.captures_play_pause))
+                    }
+                }
+            }
+        },
+        confirmButton = {
+            TextButton(onClick = onClose, modifier = Modifier.dpadFocus()) {
+                Text(stringResource(R.string.captures_close))
+            }
+        }
+    )
+}
