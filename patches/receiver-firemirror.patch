@@ -0,0 +1,69 @@
+package io.github.jqssun.airplay.service
+
+import android.media.AudioAttributes
+import android.media.AudioFormat
+import android.media.AudioTrack
+import android.util.Log
+
+/** Plays the companion phone's PCM audio without blocking its video network reader. */
+class PhoneAudioPlayer {
+    private var track: AudioTrack? = null
+
+    @Synchronized fun start(sampleRate: Int, channels: Int): Boolean {
+        stop()
+        return try {
+            val channelMask = if (channels == 1) AudioFormat.CHANNEL_OUT_MONO else AudioFormat.CHANNEL_OUT_STEREO
+            val minimum = AudioTrack.getMinBufferSize(sampleRate, channelMask, AudioFormat.ENCODING_PCM_16BIT)
+            require(minimum > 0) { "Unsupported phone audio format" }
+            val player = AudioTrack.Builder()
+                .setAudioAttributes(AudioAttributes.Builder()
+                    .setUsage(AudioAttributes.USAGE_MEDIA)
+                    .setContentType(AudioAttributes.CONTENT_TYPE_MOVIE)
+                    .build())
+                .setAudioFormat(AudioFormat.Builder()
+                    .setEncoding(AudioFormat.ENCODING_PCM_16BIT)
+                    .setSampleRate(sampleRate)
+                    .setChannelMask(channelMask)
+                    .build())
+                .setBufferSizeInBytes(maxOf(minimum, sampleRate * channels * 2 / 5))
+                .setTransferMode(AudioTrack.MODE_STREAM)
+                .build()
+            if (player.state != AudioTrack.STATE_INITIALIZED) {
+                player.release()
+                error("TV audio output did not initialize")
+            }
+            player.play()
+            track = player
+            Log.i(TAG, "Phone audio output started: $sampleRate Hz, $channels channels")
+            true
+        } catch (e: Exception) {
+            Log.w(TAG, "Phone audio playback unavailable", e)
+            false
+        }
+    }
+
+    @Synchronized fun write(bytes: ByteArray) {
+        val player = track ?: return
+        try {
+            // A full TV output buffer drops the latest chunk instead of delaying video.
+            val written = player.write(bytes, 0, bytes.size, AudioTrack.WRITE_NON_BLOCKING)
+            if (written < 0) {
+                Log.w(TAG, "Phone audio output returned $written")
+                stop()
+            }
+        } catch (e: Exception) {
+            Log.w(TAG, "Phone audio playback stopped", e)
+            stop()
+        }
+    }
+
+    @Synchronized fun stop() {
+        val player = track ?: return
+        track = null
+        runCatching { player.pause() }
+        runCatching { player.flush() }
+        runCatching { player.release() }
+    }
+
+    companion object { private const val TAG = "PhoneAudioPlayer" }
+}
