@@ -0,0 +1,145 @@
+package io.github.jqssun.airplay.service
+
+import android.util.Log
+import java.io.DataInputStream
+import java.io.DataOutputStream
+import java.net.ServerSocket
+import java.net.Socket
+import java.net.SocketException
+import java.util.concurrent.atomic.AtomicBoolean
+
+/** A small LAN transport for the companion Android sender. Video is Annex B H.264; audio is PCM16. */
+class PhoneMirrorServer(private val listener: Listener, private val port: Int = PORT) {
+    interface Listener {
+        fun approve(address: String): Boolean
+        fun started(width: Int, height: Int): Boolean
+        fun resized(width: Int, height: Int)
+        fun frame(bytes: ByteArray, timestampNs: Long)
+        fun audioStarted(sampleRate: Int, channels: Int)
+        fun audioFrame(bytes: ByteArray, timestampNs: Long)
+        fun audioEnded()
+        fun ended()
+    }
+
+    private val active = AtomicBoolean(false)
+    @Volatile private var server: ServerSocket? = null
+    @Volatile private var client: Socket? = null
+    @Volatile private var running = false
+
+    fun start(): Int {
+        if (running) return server?.localPort ?: port
+        val socket = ServerSocket(port)
+        socket.reuseAddress = true
+        server = socket
+        running = true
+        Thread({ acceptLoop(socket) }, "PhoneMirrorAccept").apply { isDaemon = true }.start()
+        return socket.localPort
+    }
+
+    fun stop() {
+        running = false
+        runCatching { server?.close() }
+        runCatching { client?.close() }
+        server = null
+        client = null
+    }
+
+    private fun acceptLoop(socket: ServerSocket) {
+        while (running) {
+            val incoming = try { socket.accept() } catch (_: SocketException) { break }
+            catch (e: Exception) { Log.w(TAG, "Accept failed", e); break }
+            incoming.soTimeout = 15_000
+            if (!active.compareAndSet(false, true)) {
+                runCatching { incoming.getOutputStream().write(0) }
+                runCatching { incoming.close() }
+                continue
+            }
+            client = incoming
+            Thread({ handle(incoming) }, "PhoneMirrorClient").apply { isDaemon = true }.start()
+        }
+    }
+
+    private fun handle(socket: Socket) {
+        var started = false
+        try {
+            socket.use {
+                val input = DataInputStream(it.getInputStream())
+                val output = DataOutputStream(it.getOutputStream())
+                val magic = input.readInt()
+                if (magic != MAGIC && magic != MAGIC_WITH_AUDIO) return
+                val width = input.readInt()
+                val height = input.readInt()
+                if (!validSize(width, height)) return
+                if (!listener.approve(it.inetAddress.hostAddress.orEmpty())) {
+                    output.writeByte(0)
+                    return
+                }
+                if (!listener.started(width, height)) {
+                    output.writeByte(0)
+                    return
+                }
+                started = true
+                output.writeByte(1)
+                output.flush()
+                it.soTimeout = 0
+                it.keepAlive = true
+                var audioConfigured = false
+                while (running) {
+                    val length = input.readInt()
+                    if (length == 0) {
+                        val nextWidth = input.readInt()
+                        val nextHeight = input.readInt()
+                        if (!validSize(nextWidth, nextHeight)) break
+                        listener.resized(nextWidth, nextHeight)
+                        continue
+                    }
+                    if (length == -1 && magic == MAGIC_WITH_AUDIO) {
+                        val sampleRate = input.readInt()
+                        val channels = input.readInt()
+                        if (sampleRate !in 8_000..96_000 || channels !in 1..2) break
+                        listener.audioStarted(sampleRate, channels)
+                        audioConfigured = true
+                        continue
+                    }
+                    if (length == -2 && magic == MAGIC_WITH_AUDIO && audioConfigured) {
+                        val timestampNs = input.readLong()
+                        val audioLength = input.readInt()
+                        if (audioLength !in 1..MAX_AUDIO_BYTES || audioLength % 2 != 0) break
+                        val data = ByteArray(audioLength)
+                        input.readFully(data)
+                        listener.audioFrame(data, timestampNs)
+                        continue
+                    }
+                    if (length == -3 && magic == MAGIC_WITH_AUDIO && audioConfigured) {
+                        audioConfigured = false
+                        listener.audioEnded()
+                        continue
+                    }
+                    if (length !in 1..MAX_FRAME_BYTES) break
+                    val timestampNs = input.readLong()
+                    val data = ByteArray(length)
+                    input.readFully(data)
+                    listener.frame(data, timestampNs)
+                }
+            }
+        } catch (e: Exception) {
+            if (running) Log.i(TAG, "Phone stream ended: ${e.message}")
+        } finally {
+            if (started) listener.ended()
+            client = null
+            active.set(false)
+        }
+    }
+
+    companion object {
+        private const val TAG = "PhoneMirrorServer"
+        const val PORT = 7102
+        const val MAGIC = 0x464D5031 // FMP1
+        const val MAGIC_WITH_AUDIO = 0x464D5032 // FMP2
+        private const val MAX_FRAME_BYTES = 2 * 1024 * 1024
+        private const val MAX_AUDIO_BYTES = 64 * 1024
+
+        private fun validSize(width: Int, height: Int) =
+            width in 64..1920 && height in 64..1920 && width.toLong() * height <= 2_073_600L
+    }
+}
