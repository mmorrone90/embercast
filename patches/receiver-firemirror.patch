+import java.io.File
+import java.text.SimpleDateFormat
+import java.util.Date
+import java.util.Locale
+import kotlin.concurrent.thread
+import kotlin.math.roundToInt
+
+/** Captures the app's current display. Files stay in FireMirror's external app folder. */
+class MirrorCapture(private val activity: Activity) {
+    private var projection: MediaProjection? = null
+    private var virtualDisplay: VirtualDisplay? = null
+    private var recorder: MediaRecorder? = null
+    private var recordingFile: File? = null
+
+    val isRecording: Boolean get() = recorder != null
+
+    fun requestIntent(): Intent =
+        (activity.getSystemService(Context.MEDIA_PROJECTION_SERVICE) as MediaProjectionManager)
+            .createScreenCaptureIntent()
+
+    fun screenshot(surface: Surface?, aspect: Float, onResult: (Result<File>) -> Unit) {
+        if (Build.VERSION.SDK_INT < Build.VERSION_CODES.O || surface?.isValid != true) {
+            onResult(Result.failure(IllegalStateException("A mirrored picture is not available")))
+            return
+        }
+        val width = (720 * aspect).roundToInt().coerceIn(480, 1920)
+        val bitmap = Bitmap.createBitmap(width, 720, Bitmap.Config.ARGB_8888)
+        runCatching { PixelCopy.request(surface, bitmap, { result ->
+            if (result != PixelCopy.SUCCESS) {
+                bitmap.recycle()
+                onResult(Result.failure(IllegalStateException("Could not capture the picture ($result)")))
+                return@request
+            }
+            thread(name = "FireMirrorScreenshot") {
+                val saved = runCatching {
+                    val file = outputFile(Environment.DIRECTORY_PICTURES, "png")
+                    file.outputStream().use { bitmap.compress(Bitmap.CompressFormat.PNG, 100, it) }
+                    file
+                }
+                bitmap.recycle()
+                Handler(Looper.getMainLooper()).post { onResult(saved) }
+            }
+        }, Handler(Looper.getMainLooper())) }.onFailure {
+            bitmap.recycle()
+            onResult(Result.failure(it))
+        }
+    }
+
+    fun startRecording(resultCode: Int, data: Intent): Result<File> = runCatching {
+        check(!isRecording) { "Recording is already active" }
+        val manager = activity.getSystemService(Context.MEDIA_PROJECTION_SERVICE) as MediaProjectionManager
+        val mediaProjection = manager.getMediaProjection(resultCode, data)
+            ?: error("Screen capture permission was not granted")
+        projection = mediaProjection
+        mediaProjection.registerCallback(object : MediaProjection.Callback() {}, Handler(Looper.getMainLooper()))
+        val file = outputFile(Environment.DIRECTORY_MOVIES, "mp4")
+        recordingFile = file
+        @Suppress("DEPRECATION")
+        val mediaRecorder = MediaRecorder()
+        recorder = mediaRecorder
+        mediaRecorder.setVideoSource(MediaRecorder.VideoSource.SURFACE)
+        mediaRecorder.setOutputFormat(MediaRecorder.OutputFormat.MPEG_4)
+        mediaRecorder.setVideoEncoder(MediaRecorder.VideoEncoder.H264)
+        mediaRecorder.setVideoSize(1280, 720)
+        mediaRecorder.setVideoFrameRate(30)
+        mediaRecorder.setVideoEncodingBitRate(3_000_000)
+        mediaRecorder.setOutputFile(file.absolutePath)
+        mediaRecorder.prepare()
+        val density = activity.resources.displayMetrics.densityDpi
+        virtualDisplay = mediaProjection.createVirtualDisplay(
+            "FireMirror recording", 1280, 720, density,
+            DisplayManager.VIRTUAL_DISPLAY_FLAG_AUTO_MIRROR,
+            mediaRecorder.surface, null, Handler(Looper.getMainLooper())
+        ) ?: error("The TV could not create a recording display")
+        mediaRecorder.start()
+        file
+    }.onFailure {
+        recordingFile?.delete()
+        releaseRecording()
+    }
+
+    fun stopRecording(): Result<File> {
+        val file = recordingFile ?: return Result.failure(IllegalStateException("No recording is active"))
+        var stopError: Throwable? = null
+        try {
+            recorder?.stop()
+        } catch (error: Throwable) {
+            stopError = error
+            file.delete()
+        } finally { releaseRecording() }
+        return if (stopError == null && file.exists() && file.length() > 0) Result.success(file)
+        else Result.failure(stopError ?: IllegalStateException("Recording was empty"))
+    }
+
+    private fun releaseRecording() {
+        runCatching { recorder?.reset() }
+        runCatching { recorder?.release() }
+        recorder = null
+        runCatching { virtualDisplay?.release() }
+        virtualDisplay = null
+        runCatching { projection?.stop() }
+        projection = null
+        recordingFile = null
+    }
+
+    private fun outputFile(folder: String, extension: String): File {
+        val root = activity.getExternalFilesDir(folder) ?: activity.filesDir
+        check(root.exists() || root.mkdirs()) { "Could not create storage folder" }
+        val time = SimpleDateFormat("yyyyMMdd_HHmmss_SSS", Locale.US).format(Date())
+        return File(root, "FireMirror_$time.$extension")
+    }
+}
