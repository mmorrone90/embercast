+@Composable
+fun HealthScreen(viewModel: MainViewModel) {
+    val server by viewModel.serverState.collectAsState()
+    val address by viewModel.networkAddress.collectAsState()
+    val connections by viewModel.connectionCount.collectAsState()
+    val mirroring by viewModel.mirroringActive.collectAsState()
+    val audio by viewModel.audioActive.collectAsState()
+    val event by viewModel.connectionEvent.collectAsState()
+    val discovery by viewModel.discoveryState.collectAsState()
+    val advertisedName by viewModel.advertisedName.collectAsState()
+    val debug by viewModel.debugInfo.collectAsState()
+    val delay by viewModel.audioLatencyMs.collectAsState()
+    var audioTestMessage by remember { mutableStateOf<String?>(null) }
+
+    val guidance = when {
+        address == null -> "Connect the Fire TV and your phone or Mac to the same local network."
+        server == ServerState.ERROR -> "The receiver could not start. Check the server port in Settings."
+        server != ServerState.RUNNING -> "Start EmberCast on the Overview screen."
+        connections == 0 -> "Mac or iPhone: choose EmberCast in Screen Mirroring. Android: open EmberCast Phone."
+        !mirroring -> "A sender connected, but no screen video has arrived yet. Check the sender's mirroring screen."
+        else -> "Screen video is arriving. Check the audio row if you expect TV sound."
+    }
+
+    Column(
+        modifier = Modifier.fillMaxSize().verticalScroll(rememberScrollState())
+            .padding(horizontal = 36.dp, vertical = 24.dp),
+        verticalArrangement = Arrangement.spacedBy(10.dp)
+    ) {
+        Text("Connection health", style = MaterialTheme.typography.headlineMedium)
+        Text(guidance, style = MaterialTheme.typography.bodyLarge,
+            color = MaterialTheme.colorScheme.onSurfaceVariant)
+        FilledTonalButton(onClick = {
+            audioTestMessage = if (viewModel.testTvAudio()) "A test tone was sent to the TV speakers."
+                else "The TV audio output could not start."
+        }, modifier = Modifier.dpadFocus()) {
+            Text("Test TV speakers")
+        }
+        audioTestMessage?.let { Text(it, color = MaterialTheme.colorScheme.onSurfaceVariant) }
+        HorizontalDivider()
+        HealthRow("Receiver", server.name.lowercase().replaceFirstChar { it.uppercase() })
+        HealthRow("AirPlay discovery", discovery.name.lowercase().replaceFirstChar { it.uppercase() })
+        HealthRow("Visible name", advertisedName ?: "Not advertised")
+        HealthRow("TV address", address ?: "No network address")
+        HealthRow("Senders", connections.toString())
+        HealthRow("Last event", event)
+        HorizontalDivider()
+        HealthRow("Screen video", if (mirroring) "Receiving" else "Waiting")
+        HealthRow("Resolution", if (mirroring) debug.videoRes else "No active stream")
+        HealthRow("Frame rate", if (mirroring) "${debug.videoFps} fps" else "No active stream")
+        HealthRow("Video bitrate", if (mirroring) debug.bitrateStr else "No active stream")
+        HealthRow("Dropped frames", if (mirroring) debug.droppedFrames.toString() else "No active stream")
+        HorizontalDivider()
+        HealthRow("TV audio", if (audio) "Receiving ${debug.audioCodec}" else "No audio stream received")
+        HealthRow("Audio timing", if (delay < 0) "Automatic" else "${delay} ms")
+        if (audio) {
+            HealthRow("Audio underruns", debug.audio?.underruns?.toString() ?: "Unavailable")
+            HealthRow("Audio buffer", debug.audio?.let { "${it.backlogMs} ms" } ?: "Unavailable")
+        }
+        Text("Measurements update while this screen is open. Audio timing and quality controls are in Settings.",
+            style = MaterialTheme.typography.bodyMedium,
+            color = MaterialTheme.colorScheme.onSurfaceVariant)
+    }
+}
+
+@Composable
+private fun HealthRow(label: String, value: String) {
+    Row(modifier = Modifier.fillMaxWidth().dpadFocus().focusable(),
+        horizontalArrangement = Arrangement.SpaceBetween) {
+        Text(label, style = MaterialTheme.typography.bodyLarge)
+        Text(value, style = MaterialTheme.typography.bodyLarge,
+            color = MaterialTheme.colorScheme.primary)
+    }
+}
