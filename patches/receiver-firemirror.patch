diff --git a/app/src/test/kotlin/io/github/jqssun/airplay/capture/CaptureTransferServerTest.kt b/app/src/test/kotlin/io/github/jqssun/airplay/capture/CaptureTransferServerTest.kt
new file mode 100644
index 0000000..1a2be6b
--- /dev/null
+++ b/app/src/test/kotlin/io/github/jqssun/airplay/capture/CaptureTransferServerTest.kt
@@ -0,0 +1,30 @@
+package io.github.jqssun.airplay.capture
+
+import java.io.File
+import java.net.HttpURLConnection
+import java.net.URL
+import org.junit.Assert.assertArrayEquals
+import org.junit.Assert.assertEquals
+import org.junit.Test
+
+class CaptureTransferServerTest {
+    @Test
+    fun onlyTheTemporaryPrivateLinkDownloadsTheSelectedCapture() {
+        val file = File.createTempFile("FireMirror_test_", ".png")
+        val content = byteArrayOf(1, 2, 3, 4, 5)
+        file.writeBytes(content)
+        try {
+            CaptureTransferServer(file, "127.0.0.1").use { server ->
+                val good = URL(server.url).openConnection() as HttpURLConnection
+                assertEquals(200, good.responseCode)
+                assertEquals("image/png", good.contentType)
+                assertArrayEquals(content, good.inputStream.use { it.readBytes() })
+
+                val bad = URL(server.url + "wrong").openConnection() as HttpURLConnection
+                assertEquals(404, bad.responseCode)
+            }
+        } finally {
+            file.delete()
+        }
+    }
+}
diff --git a/app/src/test/kotlin/io/github/jqssun/airplay/service/PhoneMirrorServerTest.kt b/app/src/test/kotlin/io/github/jqssun/airplay/service/PhoneMirrorServerTest.kt
new file mode 100644
index 0000000..06bbedd
--- /dev/null
+++ b/app/src/test/kotlin/io/github/jqssun/airplay/service/PhoneMirrorServerTest.kt
@@ -0,0 +1,123 @@
+package io.github.jqssun.airplay.service
+
+import org.junit.Assert.assertArrayEquals
+import org.junit.Assert.assertEquals
+import org.junit.Assert.assertTrue
+import org.junit.Test
+import java.io.DataInputStream
+import java.io.DataOutputStream
+import java.net.Socket
+import java.util.concurrent.CountDownLatch
+import java.util.concurrent.TimeUnit
+
+class PhoneMirrorServerTest {
+    @Test fun rotationUpdatesResolutionBeforeFollowingFrames() {
+        val received = CountDownLatch(1)
+        val events = mutableListOf<String>()
+        var frame = ByteArray(0)
+        val server = PhoneMirrorServer(object : PhoneMirrorServer.Listener {
+            override fun approve(address: String) = true
+            override fun started(width: Int, height: Int) = synchronized(events) {
+                events += "start:${width}x${height}"
+                true
+            }
+            override fun resized(width: Int, height: Int) = synchronized(events) {
+                events += "resize:${width}x${height}"
+            }
+            override fun frame(bytes: ByteArray, timestampNs: Long) {
+                synchronized(events) {
+                    events += "frame:$timestampNs"
+                    frame = bytes
+                }
+                received.countDown()
+            }
+            override fun audioStarted(sampleRate: Int, channels: Int) = Unit
+            override fun audioFrame(bytes: ByteArray, timestampNs: Long) = Unit
+            override fun audioEnded() = Unit
+            override fun ended() = Unit
+        }, port = 0)
+
+        val port = server.start()
+        try {
+            Socket("127.0.0.1", port).use { socket ->
+                val output = DataOutputStream(socket.getOutputStream())
+                val input = DataInputStream(socket.getInputStream())
+                output.writeInt(PhoneMirrorServer.MAGIC)
+                output.writeInt(432)
+                output.writeInt(960)
+                output.flush()
+                assertEquals(1, input.readUnsignedByte())
+                output.writeInt(0)
+                output.writeInt(960)
+                output.writeInt(432)
+                output.writeInt(3)
+                output.writeLong(123L)
+                output.write(byteArrayOf(1, 2, 3))
+                output.flush()
+                assertTrue(received.await(3, TimeUnit.SECONDS))
+                server.stop()
+            }
+            synchronized(events) {
+                assertEquals(listOf("start:432x960", "resize:960x432", "frame:123"), events)
+                assertArrayEquals(byteArrayOf(1, 2, 3), frame)
+            }
+        } finally {
+            server.stop()
+        }
+    }
+
+    @Test fun audioAndVideoPacketsShareOneSession() {
+        val received = CountDownLatch(2)
+        val events = mutableListOf<String>()
+        val server = PhoneMirrorServer(object : PhoneMirrorServer.Listener {
+            override fun approve(address: String) = true
+            override fun started(width: Int, height: Int) = true
+            override fun resized(width: Int, height: Int) = Unit
+            override fun frame(bytes: ByteArray, timestampNs: Long) {
+                synchronized(events) { events += "video:$timestampNs:${bytes.size}" }
+                received.countDown()
+            }
+            override fun audioStarted(sampleRate: Int, channels: Int) {
+                synchronized(events) { events += "audio:$sampleRate:$channels" }
+            }
+            override fun audioFrame(bytes: ByteArray, timestampNs: Long) {
+                synchronized(events) { events += "sound:$timestampNs:${bytes.toList()}" }
+                received.countDown()
+            }
+            override fun audioEnded() {
+                synchronized(events) { events += "audio:end" }
+            }
+            override fun ended() = Unit
+        }, port = 0)
+
+        try {
+            Socket("127.0.0.1", server.start()).use { socket ->
+                val output = DataOutputStream(socket.getOutputStream())
+                val input = DataInputStream(socket.getInputStream())
+                output.writeInt(PhoneMirrorServer.MAGIC_WITH_AUDIO)
+                output.writeInt(960)
+                output.writeInt(540)
+                output.flush()
+                assertEquals(1, input.readUnsignedByte())
+                output.writeInt(-1)
+                output.writeInt(48_000)
+                output.writeInt(2)
+                output.writeInt(-2)
+                output.writeLong(321L)
+                output.writeInt(4)
+                output.write(byteArrayOf(1, 2, 3, 4))
+                output.writeInt(-3)
+                output.writeInt(2)
+                output.writeLong(123L)
+                output.write(byteArrayOf(5, 6))
+                output.flush()
+                assertTrue(received.await(3, TimeUnit.SECONDS))
+            }
+            synchronized(events) {
+                assertEquals(listOf("audio:48000:2", "sound:321:[1, 2, 3, 4]", "audio:end", "video:123:2"), events)
+            }
+        } finally {
+            server.stop()
+        }
+    }
+}
