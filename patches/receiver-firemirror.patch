@@ -0,0 +1,30 @@
+package io.github.jqssun.airplay.capture
+
+import java.io.File
+import java.net.HttpURLConnection
+import java.net.URL
+import org.junit.Assert.assertArrayEquals
+import org.junit.Assert.assertEquals
+import org.junit.Test
+
+class CaptureTransferServerTest {
+    @Test
+    fun onlyTheTemporaryPrivateLinkDownloadsTheSelectedCapture() {
+        val file = File.createTempFile("FireMirror_test_", ".png")
+        val content = byteArrayOf(1, 2, 3, 4, 5)
+        file.writeBytes(content)
+        try {
+            CaptureTransferServer(file, "127.0.0.1").use { server ->
+                val good = URL(server.url).openConnection() as HttpURLConnection
+                assertEquals(200, good.responseCode)
+                assertEquals("image/png", good.contentType)
+                assertArrayEquals(content, good.inputStream.use { it.readBytes() })
+
+                val bad = URL(server.url + "wrong").openConnection() as HttpURLConnection
+                assertEquals(404, bad.responseCode)
+            }
+        } finally {
+            file.delete()
+        }
+    }
+}
