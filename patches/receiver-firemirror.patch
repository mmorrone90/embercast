+package io.github.jqssun.airplay.capture
+
+import java.io.File
+import java.math.BigInteger
+import java.net.ServerSocket
+import java.net.Socket
+import java.net.SocketTimeoutException
+import java.net.InetAddress
+import java.security.SecureRandom
+import java.util.concurrent.atomic.AtomicBoolean
+
+/** Shares one selected capture for ten minutes on the local network. */
+class CaptureTransferServer(private val file: File, address: String) : AutoCloseable {
+    private val socket = ServerSocket(0, 5, InetAddress.getByName(address))
+    private val running = AtomicBoolean(true)
+    private val expiresAt = System.nanoTime() / 1_000_000 + TEN_MINUTES
+    private val token = ByteArray(9).also { SecureRandom().nextBytes(it) }
+        .let { BigInteger(1, it).toString(36) }
+
+    val url: String = "http://${if (address.contains(':')) "[$address]" else address}:${socket.localPort}/$token"
+
+    private val worker = Thread({ serve() }, "FireMirrorCaptureTransfer").apply {
+        isDaemon = true
+        start()
+    }
+
+    private fun serve() {
+        socket.soTimeout = 1000
+        while (running.get() && System.nanoTime() / 1_000_000 < expiresAt) {
+            try {
+                socket.accept().use { client -> handle(client) }
+            } catch (_: SocketTimeoutException) {
+                continue
+            } catch (_: Exception) {
+                if (!running.get()) break
+            }
+        }
+        close()
+    }
+
+    private fun handle(client: Socket) {
+        client.soTimeout = 5000
+        val reader = client.getInputStream().bufferedReader(Charsets.US_ASCII)
+        val request = reader.readLine()?.take(4096) ?: return
+        var count = 0
+        while (count++ < 40) {
+            val header = reader.readLine() ?: break
+            if (header.isEmpty()) break
+        }
+        val output = client.getOutputStream()
+        if (request != "GET /$token HTTP/1.1" && request != "GET /$token HTTP/1.0") {
+            output.write("HTTP/1.1 404 Not Found\r\nContent-Length: 0\r\nConnection: close\r\n\r\n".toByteArray())
+            return
+        }
+        if (!file.isFile || System.nanoTime() / 1_000_000 >= expiresAt) {
+            output.write("HTTP/1.1 410 Gone\r\nContent-Length: 0\r\nConnection: close\r\n\r\n".toByteArray())
+            return
+        }
+        val type = if (file.extension.lowercase() == "mp4") "video/mp4" else "image/png"
+        val safeName = file.name.replace(Regex("[^A-Za-z0-9_.]"), "_")
+        val headers = "HTTP/1.1 200 OK\r\nContent-Type: $type\r\n" +
+            "Content-Length: ${file.length()}\r\n" +
+            "Content-Disposition: attachment; filename=\"$safeName\"\r\n" +
+            "Cache-Control: no-store\r\nX-Content-Type-Options: nosniff\r\n" +
+            "Connection: close\r\n\r\n"
+        output.write(headers.toByteArray(Charsets.US_ASCII))
+        file.inputStream().use { it.copyTo(output) }
+        output.flush()
+    }
+
+    override fun close() {
+        running.set(false)
+        runCatching { socket.close() }
+    }
+
+    companion object {
+        private const val TEN_MINUTES = 10 * 60 * 1000L
+    }
+}
