+@Composable
+fun CapturesScreen() {
+    val context = LocalContext.current
+    fun files(): List<File> = listOf(Environment.DIRECTORY_PICTURES, Environment.DIRECTORY_MOVIES)
+        .flatMap { folder -> context.getExternalFilesDir(folder)?.listFiles()?.toList().orEmpty() }
+        .filter { it.isFile && it.name.startsWith("FireMirror_") && it.extension in setOf("png", "mp4") }
+        .sortedByDescending { it.lastModified() }
+
+    var captures by remember { mutableStateOf(files()) }
+    var toDelete by remember { mutableStateOf<File?>(null) }
+
+    Column(modifier = Modifier.fillMaxSize().padding(horizontal = 36.dp, vertical = 24.dp)) {
+        Row(
+            modifier = Modifier.fillMaxWidth(),
+            horizontalArrangement = Arrangement.SpaceBetween,
+            verticalAlignment = Alignment.CenterVertically
+        ) {
+            Text(stringResource(R.string.captures_title), style = MaterialTheme.typography.headlineMedium)
+            FilledTonalButton(onClick = { captures = files() }, modifier = Modifier.dpadFocus()) {
+                Text(stringResource(R.string.captures_refresh))
+            }
+        }
+        Spacer(Modifier.height(20.dp))
+        if (captures.isEmpty()) {
+            Text(
+                stringResource(R.string.captures_empty),
+                color = MaterialTheme.colorScheme.onSurfaceVariant,
+                style = MaterialTheme.typography.bodyLarge
+            )
+        } else {
+            LazyColumn {
+                items(captures, key = { it.absolutePath }) { file ->
+                    Row(
+                        modifier = Modifier.fillMaxWidth().padding(vertical = 12.dp),
+                        horizontalArrangement = Arrangement.spacedBy(16.dp),
+                        verticalAlignment = Alignment.CenterVertically
+                    ) {
+                        Icon(if (file.extension == "mp4") Icons.Default.Movie else Icons.Default.Photo, null)
+                        Column(modifier = Modifier.weight(1f)) {
+                            Text(file.name, style = MaterialTheme.typography.titleMedium)
+                            Text("${file.length() / 1024} KB", color = MaterialTheme.colorScheme.onSurfaceVariant)
+                        }
+                        TextButton(onClick = {
+                            val uri = FileProvider.getUriForFile(context, "${context.packageName}.fileprovider", file)
+                            val mime = if (file.extension == "mp4") "video/mp4" else "image/png"
+                            val intent = Intent(Intent.ACTION_SEND).apply {
+                                type = mime
+                                putExtra(Intent.EXTRA_STREAM, uri)
+                                addFlags(Intent.FLAG_GRANT_READ_URI_PERMISSION)
+                            }
+                            context.startActivity(Intent.createChooser(intent, context.getString(R.string.captures_share)))
+                        }, modifier = Modifier.dpadFocus()) {
+                            Text(stringResource(R.string.captures_share))
+                        }
+                        TextButton(onClick = { toDelete = file }, modifier = Modifier.dpadFocus()) {
+                            Icon(Icons.Default.Delete, null)
+                            Text(stringResource(R.string.captures_delete))
+                        }
+                    }
+                    HorizontalDivider()
+                }
+            }
+        }
+    }
+
+    toDelete?.let { file ->
+        AlertDialog(
+            onDismissRequest = { toDelete = null },
+            title = { Text(stringResource(R.string.captures_delete_title)) },
+            text = { Text(stringResource(R.string.captures_delete_message, file.name)) },
+            confirmButton = {
+                TextButton(onClick = {
+                    file.delete()
+                    captures = files()
+                    toDelete = null
+                }, modifier = Modifier.dpadFocus()) { Text(stringResource(R.string.captures_delete)) }
+            },
+            dismissButton = {
+                TextButton(onClick = { toDelete = null }, modifier = Modifier.dpadFocus()) {
+                    Text(stringResource(R.string.captures_cancel))
+                }
+            }
+        )
+    }
+}
